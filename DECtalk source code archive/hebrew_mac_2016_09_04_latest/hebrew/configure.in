case "$target" in
	alpha-*-linux-*) LINK_PORT_AUDIO="" ;;
	powerpc-apple-*) LINK_PORT_AUDIO="" ;;
	armv5-apple-*) LINK_PORT_AUDIO="" ;;
	armv6-apple-*) LINK_PORT_AUDIO="" ;;
	armv7-apple-*) LINK_PORT_AUDIO="" ;;
	armv8-apple-*) LINK_PORT_AUDIO="" ;;
	i386-apple-*) LINK_PORT_AUDIO="" ;;
	x86_64-apple-*) LINK_PORT_AUDIO="" ;;
	*-*-solaris*) LINK_PORT_AUDIO="" ;;
	*-*-linux-*) LINK_PORT_AUDIO="" ;;
esac
