        armv8-apple-*) ML_TTS_SO="\$(CC) -isysroot /Applications/Xcode.app/Contents/Developer/Platforms/iPhoneOS.platform/Developer/SDKs/iPhoneOS8.3.sdk -mios-version-min=6.1 -dynamic -dynamiclib \
