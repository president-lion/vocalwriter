dnl
dnl Configure template for DECtalk
dnl this is a comment.  Weird huh?
dnl *********************************************************************
dnl *   File Name:      configure.in
dnl *   Author:		Eric Thompson
dnl *   Creation Date:	10/22/1998
dnl *
dnl *   Functionality:
dnl *  	Process this file with autoconf to produce a configure script. 
dnl *	The configure script produces various Makefile from various Makefile.in
dnl *
dnl *********************************************************************
dnl *    Revision History:
dnl *
dnl *  Rev  Who		Date		Description
dnl *  ---  ------	-----------	----------------------------------
dnl *  000  ETT		10/22/1998	produces Makefiles for x86 linux (elf)
dnl *  001  ETT		11/04/1998	produces Makefiles for alpha linux
dnl *  002  ETT		11/17/1998	arm linux for the itsy (aout)
dnl *  003  ET		11/23/1998	Digital Unix 4.0[d,e]
dnl *  004  ETT		11/24/1998	fix linux again
dnl *  005  ETT		12/04/1998	added stuff for speak, etc.
dnl *  006  ETT		12/07/1998	added yet another variable for osf
dnl *							SO_LOCATIONS, I tell ya...
dnl *  007  NAL         04/10/2000      Added stuff for gspeakdemos
dnl *  008  MGS         05/26/2000      Added windict stuff
dnl *  009  MGS		03/29/2001	Added stuff for french and windic and ml location
dnl *  010  MGS		06/19/2001	Solaris Port BATS#972
dnl *********************************************************************
dnl * see: http://www.sdsu.edu/doc/texi/autoconf_toc.html 
dnl * for help and documentation.

dnl AC_REVISION([configure.in 0.01])   

dnl AC_INIT always has to be first. except AC_REVISION
dnl the filename specified here is just so that autoconf
dnl is sure that this is _actually_ the src dir
AC_INIT(dectalkf.h)

dnl Determine the system type and set output variables to the names 
dnl of the canonical system types.
dnl build, host, target 
dnl      the canonical system names; 
dnl build_alias, host_alias, target_alias 
dnl      the names user specified, or canonical names from config.guess 
dnl build_cpu, build_vendor, build_os 
dnl host_cpu, host_vendor, host_os 
dnl target_cpu, target_vendor, target_os 
dnl      the individual parts of the canonical names (for convenience). 
AC_CANONICAL_SYSTEM
dnl AC_CANONICAL_SYSTEM requires config.guess and config.sub shell scripts

dnl Determine a C compiler to use. If CC is not already set in the environment,
dnl check for gcc, and use cc if that's not found. Set output variable CC 
dnl to the name of the compiler found.  
AC_PROG_CC
case "$target" in
	arm-ipaq-linux-*) CC="/skiff/local/bin/arm-linux-gcc" ;;
	arm-*-linux-*) CC="/usr/local/arm/3.4.1/bin/arm-linux-gcc" ;;
	armv5-apple-*) CC="/usr/bin/gcc" ;;
	armv6-apple-*) CC="/usr/bin/gcc" ;;
	armv7-apple-*) CC="/usr/bin/gcc" ;;
	armv8-apple-*) CC="/usr/bin/gcc" ;;
	armv9-apple-*) CC="/Applications/Xcode.app/Contents/Developer/Platforms/iPhoneOS.platform/Developer/usr/bin/gcc" ;;
	armv0-apple-*) CC="/Applications/Xcode.app/Contents/Developer/Platforms/iPhoneOS.platform/Developer/usr/bin/gcc" ;;
	powerpc-apple-*) CC="/usr/bin/gcc" ;;
	i386-apple-*) CC="/usr/bin/gcc" ;;
	x86_64-apple-*) CC="/usr/bin/gcc" ;;
	powerpc-*-linux-*) CC="/opt/eldk/usr/bin/ppc-linux-gcc" ;;
	powerpc-*-nto-*) CC="qcc -V2.95.3,gcc_ntoppcbe" ;;
	*-*-nto-*) CC="qcc" ;;
dnl use the itsy cross compiler.
esac

dnl If the C compiler does not accept the `-c' and `-o' options 
dnl simultaneously, define NO_MINUS_C_MINUS_O. 
AC_PROG_CC_C_O

dnl Set output variable CPP to a command that runs the C preprocessor. 
dnl If `$CC -E' doesn't work, it uses `/lib/cpp'. It is only portable 
dnl to run CPP on files with a `.c' extension.
dnl AC_PROG_CPP

dnl If `ln -s' works on the current filesystem, set output variable LN_S 
dnl to `ln -s', otherwise set it to `ln'.
AC_PROG_LN_S 
case "$target" in
	sparc-sun-*) LN_S="ln -f -s" ;;
	i386*-solaris*) LN_S="ln -f -s"  ;;
	powerpc-apple-*) LN_S="ln -f -s"  ;;
	i386-apple-*) LN_S="ln -f -s"  ;;
	x86_64-apple-*) LN_S="ln -f -s"  ;;
	armv5-apple-*) LN_S="ln -f -s"  ;;
	armv6-apple-*) LN_S="ln -f -s"  ;;
	armv7-apple-*) LN_S="ln -f -s"  ;;
	armv8-apple-*) LN_S="ln -f -s"  ;;
	arm-ipaq-linux-*) LN_S="ln -f -s"  ;;
	arm-*-linux-*) LN_S="ln -f -s"  ;;
	powerpc-*-linux-*) LN_S="ln -f -s"  ;;
	*-*-linux-*) LN_S="ln -f -s"  ;;
	powerpc-*-nto-*) LN_S="ln -f -s"  ;;
	*-*-nto-*) LN_S="ln -f -s"  ;;
esac

dnl Set output variable RANLIB to `ranlib' if ranlib is found, 
dnl otherwise to `:' (do nothing). 
AC_PROG_RANLIB 
case "$target" in
	arm-ipaq-linux-*) RANLIB="/skiff/local/bin/arm-linux-ranlib" ;;
	arm-*-linux-*) RANLIB="/usr/local/arm/3.4.1/bin/arm-linux-ranlib" ;;
	powerpc-*-linux-*) RANLIB="/opt/eldk/usr/bin/ppc-linux-ranlib" ;;
dnl use the itsy ranlib.
esac

dnl these are single backquotes!
dnl OS_VERSION=`uname -srm`
OS_VERSION=`uname -r`
case "$target" in 
	powerpc-apple-*) OS_VERSION="ppc-"`uname -r` ;;
	armv5-apple-*) OS_VERSION="armv6sim-"`uname -r` ;;
	armv6-apple-*) OS_VERSION="armv7sim-"`uname -r` ;;
	armv7-apple-*) OS_VERSION="armv7-"`uname -r` ;;
	armv8-apple-*) OS_VERSION="arm64-"`uname -r` ;;
	i386-apple-*) OS_VERSION="intel-"`uname -r` ;;
	x86_64-apple-*) OS_VERSION="intel64-"`uname -r` ;;
esac
AC_SUBST(OS_VERSION)dnl

dnl don't put a slash on the end of this dir.  
dnl it shouldn't matter but why chance it?
BUILD_DIR=`pwd`"/dapi/build"
case "$target" in
	arm-ipaq-linux-*) BUILD_DIR=`pwd`"/dapi/build" ;;
	arm-itsy-linux-*) BUILD_DIR=`pwd`"/dapi/build" ;;
esac
AC_SUBST(BUILD_DIR)dnl

DEFINES=" -DLTSSIM -DTTSSIM -DANSI -DBLD_DECTALK_DLL -D\$(LANGUAGE) -DACCESS32 -DTYPING_MODE -DNO_INCLUDED_C_FILES -DNEW_MULTI_LANG_ARCH -DMULTIPLE_LANGUAGES_LOADED -DHLSYN" 
case "$target" in
	sparc-sun-*) DEFINES=" -DLTSSIM -D_SPARC_SOLARIS_ -D_BIGENDIAN_ -DTTSSIM -DANSI -DBLD_DECTALK_DLL -D\$(LANGUAGE) -DACCESS32 -DTYPING_MODE -DNO_INCLUDED_C_FILES -DNEW_MULTI_LANG_ARCH -DMULTIPLE_LANGUAGES_LOADED -DHLSYN" ;;
	i386*-solaris*) DEFINES=" -DLTSSIM -D_INTEL_SOLARIS_ -DTTSSIM -DANSI -DBLD_DECTALK_DLL -D\$(LANGUAGE) -DACCESS32 -DTYPING_MODE -DNO_INCLUDED_C_FILES -DNEW_MULTI_LANG_ARCH -DMULTIPLE_LANGUAGES_LOADED -DHLSYN" ;;
	powerpc-apple-*) DEFINES=" -DLTSSIM -D_APPLE_MAC_ -DNO_SESSION -D_BIGENDIAN_ -DTTSSIM -DANSI -DBLD_DECTALK_DLL -D\$(LANGUAGE) -DACCESS32 -DTYPING_MODE -DNO_INCLUDED_C_FILES -DNEW_MULTI_LANG_ARCH -DMULTIPLE_LANGUAGES_LOADED -DHLSYN -DMACOS_STATIC -dynamic" ;;
	armv5-apple-*) DEFINES=" -DLTSSIM -D_IOS61_ -D_IOS_ -D_IOSSIMULATOR_ -D_APPLE_MAC_ -D_BIGENDIAN_ -DTTSSIM -DANSI -DBLD_DECTALK_DLL -D\$(LANGUAGE) -DACCESS32 -DTYPING_MODE -DNO_INCLUDED_C_FILES -DNEW_MULTI_LANG_ARCH -DMULTIPLE_LANGUAGES_LOADED -DHLSYN -DMACOS_STATIC -dynamic" ;;
	armv6-apple-*) DEFINES=" -DLTSSIM -D_IOS61_ -D_IOS_ -D_IOSSIMULATOR_ -D_IOS_64BIT_ -D_APPLE_MAC_ -D_BIGENDIAN_ -DTTSSIM -DANSI -DBLD_DECTALK_DLL -D\$(LANGUAGE) -DACCESS32 -DTYPING_MODE -DNO_INCLUDED_C_FILES -DNEW_MULTI_LANG_ARCH -DMULTIPLE_LANGUAGES_LOADED -DHLSYN -DMACOS_STATIC -dynamic" ;;
	armv7-apple-*) DEFINES=" -DLTSSIM -D_IOS61_ -D_IOS_ -D_APPLE_MAC_ -D_BIGENDIAN_ -DTTSSIM -DANSI -DBLD_DECTALK_DLL -D\$(LANGUAGE) -DACCESS32 -DTYPING_MODE -DNO_INCLUDED_C_FILES -DNEW_MULTI_LANG_ARCH -DMULTIPLE_LANGUAGES_LOADED -DHLSYN -DMACOS_STATIC -dynamic" ;;
	armv8-apple-*) DEFINES=" -DLTSSIM -D_IOS61_ -D_IOS_ -D_IOS_64BIT_ -D_APPLE_MAC_ -D_BIGENDIAN_ -DTTSSIM -DANSI -DBLD_DECTALK_DLL -D\$(LANGUAGE) -DACCESS32 -DTYPING_MODE -DNO_INCLUDED_C_FILES -DNEW_MULTI_LANG_ARCH -DMULTIPLE_LANGUAGES_LOADED -DHLSYN -DMACOS_STATIC -dynamic" ;;
	i386-apple-*) DEFINES=" -DLTSSIM -D_APPLE_MAC_ -D_MAC_OSX_ -DNO_SESSION -DTTSSIM -DANSI -DBLD_DECTALK_DLL -D\$(LANGUAGE) -DACCESS32 -DTYPING_MODE -DNO_INCLUDED_C_FILES -DNEW_MULTI_LANG_ARCH -DMULTIPLE_LANGUAGES_LOADED -DHLSYN -DMACOS_STATIC -dynamic" ;;
	x86_64-apple-*) DEFINES=" -DLTSSIM -D_APPLE_MAC_ -D_MAC_OSX_ -D_APPLE_MAC_64BIT_ -DNO_SESSION -DTTSSIM -DANSI -DBLD_DECTALK_DLL -D\$(LANGUAGE) -DACCESS32 -DTYPING_MODE -DNO_INCLUDED_C_FILES -DNEW_MULTI_LANG_ARCH -DMULTIPLE_LANGUAGES_LOADED -DHLSYN -DMACOS_STATIC -dynamic" ;;
	arm-ipaq-linux-*) DEFINES=" -D_REENTRANT -D_GNU_SOURCE -DNOMME -D__ipaq__ -DLTSSIM -DTTSSIM -DANSI -DBLD_DECTALK_DLL -D\$(LANGUAGE) -DACCESS32 -DTYPING_MODE -DNO_INCLUDED_C_FILES -DNEW_MULTI_LANG_ARCH -DMULTIPLE_LANGUAGES_LOADED -DHLSYN" ;;
	arm-*-linux-*) DEFINES=" -D_REENTRANT -D_GNU_SOURCE -DNOMME -DLTSSIM -DTTSSIM -DANSI -DBLD_DECTALK_DLL -D\$(LANGUAGE) -DACCESS32 -DTYPING_MODE -DNO_INCLUDED_C_FILES -DNEW_MULTI_LANG_ARCH -DMULTIPLE_LANGUAGES_LOADED -DHLSYN" ;;
	powerpc-*-linux-*) DEFINES=" -D_REENTRANT -DNOMME -D_BIGENDIAN_ -DLTSSIM -DTTSSIM -DANSI -DBLD_DECTALK_DLL -D\$(LANGUAGE) -DACCESS32 -DTYPING_MODE -DNO_INCLUDED_C_FILES -DNEW_MULTI_LANG_ARCH -DMULTIPLE_LANGUAGES_LOADED -DHLSYN" ;;
	*-*-linux-*) DEFINES=" -D_REENTRANT -DNOMME -DLTSSIM -DTTSSIM -DANSI -DBLD_DECTALK_DLL -D\$(LANGUAGE) -DACCESS32 -DTYPING_MODE -DNO_INCLUDED_C_FILES -DNEW_MULTI_LANG_ARCH -DMULTIPLE_LANGUAGES_LOADED -DHLSYN" ;;
	powerpc-*-nto-*) DEFINES=" -D_REENTRANT -DNOMME -D_BIGENDIAN_ -DLTSSIM -DTTSSIM -DANSI -DBLD_DECTALK_DLL -D\$(LANGUAGE) -DACCESS32 -DTYPING_MODE -DNO_INCLUDED_C_FILES -DNEW_MULTI_LANG_ARCH -DMULTIPLE_LANGUAGES_LOADED -DHLSYN" ;;
	*-*-nto-*) DEFINES=" -D_REENTRANT -DNOMME -DLTSSIM -DTTSSIM -DANSI -DBLD_DECTALK_DLL -D\$(LANGUAGE) -DACCESS32 -DTYPING_MODE -DNO_INCLUDED_C_FILES -DNEW_MULTI_LANG_ARCH -DMULTIPLE_LANGUAGES_LOADED -DHLSYN" ;;
esac
AC_SUBST(DEFINES)dnl

LICENSE_DEFINES=""
case "$target" in
	powerpc-*-linux-*) LICENSE_DEFINES="-D_BIGENDIAN_";;
	*-*-linux-*) LICENSE_DEFINES="";;
	sparc-sun-*) LICENSE_DEFINES="-D_SPARC_SOLARIS_ -D_BIGENDIAN_";;
	i386-*-solaris*) LICENSE_DEFINES="-D_INTEL_SOLARIS_ ";;
	armv5-apple-*) LICENSE_DEFINES="-D_SPARC_SOLARIS_";;
	armv6-apple-*) LICENSE_DEFINES="-D_SPARC_SOLARIS_";;
	armv7-apple-*) LICENSE_DEFINES="-D_SPARC_SOLARIS_";;
	armv8-apple-*) LICENSE_DEFINES="-D_SPARC_SOLARIS_";;
	powerpc-apple-*) LICENSE_DEFINES="-D_SPARC_SOLARIS_ -D_BIGENDIAN_";;
	i386-apple-*) LICENSE_DEFINES="-D_SPARC_SOLARIS_";;
	x86_64-apple-*) LICENSE_DEFINES="-D_SPARC_SOLARIS_";;
esac
AC_SUBST(LICENSE_DEFINES)dnl

LICENSE_ALL="\$(OUTPUT_DIR)/licenin1 \$(OUTPUT_DIR)/licenin3 \
            \$(OUTPUT_DIR)/licenin7 \$(OUTPUT_DIR)/installer"
case "$target" in
	alpha-dec-osf*) LICENSE_ALL="";;
	arm-*-linux-*) LICENSE_ALL="\$(OUTPUT_DIR)/licenin1 \$(OUTPUT_DIR)/licenin3 \$(OUTPUT_DIR)/licenin7 \$(OUTPUT_DIR)/arminstaller" ;;
esac
AC_SUBST(LICENSE_ALL)dnl
	
DEBUG_FLAGS=" -G3 -migrate"
case "$target" in
	arm-ipaq-linux-*) DEBUG_FLAGS=" -g -fPIC -D__ipaq__";;
	arm-*-linux-*) DEBUG_FLAGS=" -g -fPIC";;
	powerpc-*-linux-*) DEBUG_FLAGS=" -g -fPIC -D__powerpc__";;
	*-*-linux-*) DEBUG_FLAGS=" -g" ;;
	*-*-nto-*) DEBUG_FLAGS=" -g" ;;
	*-*-solaris*) DEBUG_FLAGS=" -g" ;;
	powerpc-apple-*) DEBUG_FLAGS=" -g -arch ppc" ;;
	armv5-apple-*) DEBUG_FLAGS="-isysroot /Applications/Xcode.app/Contents/Developer/Platforms/iPhoneSimulator.platform/Developer/SDKs/iPhoneSimulator.sdk -g -arch i386 -mios-simulator-version-min=6.1" ;;
	armv6-apple-*) DEBUG_FLAGS="-isysroot /Applications/Xcode.app/Contents/Developer/Platforms/iPhoneSimulator.platform/Developer/SDKs/iPhoneSimulator.sdk -g -arch x86_64 -mios-simulator-version-min=6.1" ;;
	armv7-apple-*) DEBUG_FLAGS="-isysroot /Applications/Xcode.app/Contents/Developer/Platforms/iPhoneOS.platform/Developer/SDKs/iPhoneOS.sdk -g -arch armv7 -mios-version-min=6.1" ;;
	armv8-apple-*) DEBUG_FLAGS="-isysroot /Applications/Xcode.app/Contents/Developer/Platforms/iPhoneOS.platform/Developer/SDKs/iPhoneOS8.3.sdk -g -arch arm64 -mios-version-min=6.1 -Wno-implicit-function-declaration" ;;
	i386-apple-*) DEBUG_FLAGS=" -g -arch i386" ;;
	x86_64-apple-*) DEBUG_FLAGS=" -g -arch x86_64" ;;
esac
AC_SUBST(DEBUG_FLAGS)dnl

LIB_FLAGS="" 
case "$target" in
	*-*-nto-*) LIB_FLAGS="-shared" ;;
esac
AC_SUBST(LIB_FLAGS)dnl

OPTO_FLAGS=" -O2"
case "$target" in
	sparc-sun-*) OPTO_FLAGS="-O2" ;;
esac
AC_SUBST(OPTO_FLAGS)dnl

PLATFORM_DEFS=""
case "$target" in
	powerpc-*-linux-*) PLATFORM_DEFS="-D_BIGENDIAN_" ;;
	sparc-sun-*) PLATFORM_DEFS="-D_SPARC_SOLARIS_ -D_BIGENDIAN_" ;;
	i386-*-solaris*) PLATFORM_DEFS="-D_INTEL_SOLARIS_" ;;
	powerpc-apple-*) PLATFORM_DEFS="-D_BIGENDIAN_" ;;
	armv5-apple-*) PLATFORM_DEFS="-isysroot /Developer/Platforms/iPhoneSimulator.platform/Developer/SDKs/iPhoneSimulator.sdk" ;;
	armv6-apple-*) PLATFORM_DEFS="-isysroot /Developer/Platforms/iPhoneSimulator.platform/Developer/SDKs/iPhoneSimulator.sdk" ;;
	armv7-apple-*) PLATFORM_DEFS="-isysroot /Developer/Platforms/iPhoneOS.platform/Developer/SDKs/iPhoneOS.sdk" ;;
	armv8-apple-*) PLATFORM_DEFS="-isysroot /Developer/Platforms/iPhoneOS.platform/Developer/SDKs/iPhoneOS8.3.sdk" ;;
	i386-apple-*) PLATFORM_DEFS="" ;;
	x86_64-apple-*) PLATFORM_DEFS="" ;;
esac
AC_SUBST(PLATFORM_DEFS)dnl

ENDIAN_PARM=""
case "$target" in
	powerpc-*-linux-*) ENDIAN_PARM="/e:other" ;;
esac
AC_SUBST(ENDIAN_PARM)dnl

ALIGN_OPT=""
case "$target" in
	sparc-sun-*) ALIGN_OPT="" ;;
esac
AC_SUBST(ALIGN_OPT)dnl

WARN_FLAGS=" -threads -w1"
case "$target" in
	*-*-linux-*) WARN_FLAGS=" -Wall" ;;
	*-*-nto-*) WARN_FLAGS=" -Wall" ;;
	powerpc-apple-*) WARN_FLAGS=" -Wall" ;;
	armv5-apple-*) WARN_FLAGS="-Wno-pointer-sign" ;;
	armv6-apple-*) WARN_FLAGS="-Wno-pointer-sign" ;;
	armv7-apple-*) WARN_FLAGS="-Wno-pointer-sign" ;;
	armv8-apple-*) WARN_FLAGS="-Wno-pointer-sign" ;;
	i386-apple-*) WARN_FLAGS=" -Wall" ;;
	x86_64-apple-*) WARN_FLAGS=" -Wall" ;;
	*-*-solaris*) WARN_FLAGS=" " ;;
esac
AC_SUBST(WARN_FLAGS)dnl

PH_VTM_OPTO_FLAGS=" -O2"
case "$target" in
	arm-*-linux-*) PH_VTM_OPTO_FLAGS="" ;;
	*-*-solaris*) PH_VTM_OPTO_FLAGS="-O2" ;;
	powerpc-apple-*) PH_VTM_OPTO_FLAGS="-O2" ;;
	armv5-apple-*) PH_VTM_OPTO_FLAGS="-O2" ;;
	armv6-apple-*) PH_VTM_OPTO_FLAGS="-O2" ;;
	armv7-apple-*) PH_VTM_OPTO_FLAGS="-O2" ;;
	armv8-apple-*) PH_VTM_OPTO_FLAGS="-O2" ;;
	i386-apple-*) PH_VTM_OPTO_FLAGS="-O2" ;;
	x86_64-apple-*) PH_VTM_OPTO_FLAGS="-O2" ;;
dnl for some reason the itsy ph and vtm files can't be optimized too far.
esac
AC_SUBST(PH_VTM_OPTO_FLAGS)dnl

dnl the dictionary compiler must be built for host not target
DIC_CC="gcc"
case "$target" in
	*-*-solaris*) DIC_CC="gcc" ;;
	alpha-dec-osf*) DIC_CC="cc" ;;
esac
AC_SUBST(DIC_CC)dnl

LD="ld"
case "$target" in
	arm-ipaq-linux-*) LD="/skiff/local/bin/arm-linux-ld" ;;
	arm-*-linux-*) LD="/usr/local/arm/3.4.1/bin/arm-linux-ld" ;;
	powerpc-*-linux-*) LD="/opt/eldk/usr/bin/ppc-linux-ld" ;;
	powerpc-*-nto-*) LD="qcc -V2.95.3,gcc_ntoppcbe" ;;
	*-*-nto-*) LD="qcc" ;;
dnl use the itsy dynamic linker.
esac
AC_SUBST(LD)dnl

AR="ar cqls"
case "$target" in
	arm-ipaq-linux-*) AR="/skiff/local/bin/arm-linux-ar cqls" ;;
	arm-*-linux-*) AR="/usr/local/arm/3.4.1/bin/arm-linux-ar cqls" ;;
	powerpc-*-linux-*) AR="/opt/eldk/usr/bin/ppc-linux-ar cqls" ;;
	powerpc-apple-*) AR="ar ruvs" ;;
	armv5-apple-*) AR="ar ruvs" ;;
	armv6-apple-*) AR="ar ruvs" ;;
	armv7-apple-*) AR="ar ruvs" ;;
	armv8-apple-*) AR="ar ruvs" ;;
	i386-apple-*) AR="ar ruvs" ;;
	x86_64-apple-*) AR="ar ruvs" ;;
dnl use the itsy archiver.
esac
AC_SUBST(AR)dnl

STD_INCLUDE="/usr/include/"
case "$target" in
	arm-ipaq-linux-*) STD_INCLUDE="/skiff/local/arm-linux/include" ;;
	arm-*-linux-*) STD_INCLUDE="/usr/local/arm/3.4.1/include" ;;
	powerpc-*-linux-*) STD_INCLUDE="/opt/eldk/ppc_6xx/usr/include" ;;
	armv5-apple-*) STD_INCLUDE="/Applications/Xcode.app/Contents/Developer/Platforms/iPhoneSimumator.platform/Developer/SDKs/iPhoneSimulator.sdk/usr/include" ;;
	armv6-apple-*) STD_INCLUDE="/Applications/Xcode.app/Contents/Developer/Platforms/iPhoneSimumator.platform/Developer/SDKs/iPhoneSimulator.sdk/usr/include" ;;
	armv7-apple-*) STD_INCLUDE="/Applications/Xcode.app/Contents/Developer/Platforms/iPhoneOS.platform/Developer/SDKs/iPhoneOS.sdk/usr/include" ;;
	armv8-apple-*) STD_INCLUDE="/Applications/Xcode.app/Contents/Developer/Platforms/iPhoneOS.platform/Developer/SDKs/iPhoneOS8.3.sdk/usr/include" ;;
dnl the itsy cross compiler knows where to get the std includes.
esac
AC_SUBST(STD_INCLUDE)dnl

MME_DIR="."
case "$target" in
	alpha-dec-osf*) MME_DIR="/usr/include/mme" ;;
esac
AC_SUBST(MME_DIR)dnl

LINUX_AUDIO=""
case "$target" in
	*-*-solaris*) LINUX_AUDIO="\$(OUTPUT_DIR)/linux_audio.o" ;;
	powerpc-apple-*) LINUX_AUDIO="" ;;
	armv5-apple-*) LINUX_AUDIO="" ;;
	armv6-apple-*) LINUX_AUDIO="" ;;
	armv7-apple-*) LINUX_AUDIO="" ;;
	armv8-apple-*) LINUX_AUDIO="" ;;
	i386-apple-*) LINUX_AUDIO="" ;;
	x86_64-apple-*) LINUX_AUDIO="" ;;
	*-*-linux-*) LINUX_AUDIO="\$(OUTPUT_DIR)/linux_audio.o" ;;
	*-*-nto-*) LINUX_AUDIO="\$(OUTPUT_DIR)/qnx_audio.o" ;;
esac
AC_SUBST(LINUX_AUDIO)dnl

LINK_LINUX_AUDIO=""
case "$target" in
	alpha-*-linux-*) LINK_LINUX_AUDIO="" ;;
	powerpc-apple-*) LINK_LINUX_AUDIO="" ;;
	armv5-apple-*) LINK_LINUX_AUDIO="" ;;
	armv6-apple-*) LINK_LINUX_AUDIO="" ;;
	armv7-apple-*) LINK_LINUX_AUDIO="" ;;
	armv8-apple-*) LINK_LINUX_AUDIO="" ;;
	i386-apple-*) LINK_LINUX_AUDIO="" ;;
	x86_64-apple-*) LINK_LINUX_AUDIO="" ;;
	*-*-solaris*) LINK_LINUX_AUDIO="\$(OUTPUT_DIR_2)/linux_audio.o" ;;
	*-*-linux-*) LINK_LINUX_AUDIO="\$(OUTPUT_DIR_2)/linux_audio.o" ;;
	*-*-nto-*) LINK_LINUX_AUDIO="\$(OUTPUT_DIR_2)/qnx_audio.o" ;;
esac
AC_SUBST(LINK_LINUX_AUDIO)dnl

PLAYAUD="playaud.o"
case "$target" in
	i386-apple-*) PLAYAUD="playaud_mac.o" ;;
	x86_64-apple-*) PLAYAUD="playaud_mac.o" ;;
	powerpc-apple-*) PLAYAUD="playaud_mac.o" ;;
	armv5-apple-*) PLAYAUD="playaud_ios.o" ;;
	armv6-apple-*) PLAYAUD="playaud_ios.o" ;;
	armv7-apple-*) PLAYAUD="playaud_ios.o" ;;
	armv8-apple-*) PLAYAUD="playaud_ios.o" ;;
esac
AC_SUBST(PLAYAUD)dnl


dnl	powerpc-apple-*) LINK_PORT_AUDIO="../shared/src/3rdParty/portaudio/lib/libportaudio.a" ;;
