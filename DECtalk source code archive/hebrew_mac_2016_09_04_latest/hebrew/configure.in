dnl always use the "-lpthread" NOT "-lpthreads" in linux
MMELIBS=" -lmme"
case "$target" in
	arm-*-linux-*) MMELIBS=" -lpthread " ;;
	*-*-linux-*) MMELIBS=" -lpthread" ;;
	*-*-nto-*) MMELIBS=" -lasound -lc" ;;
	powerpc-apple-*) MMELIBS=" -lpthread" ;;
	armv5-apple-*) MMELIBS=" -lpthread" ;;
	armv6-apple-*) MMELIBS=" -lpthread" ;;
	armv7-apple-*) MMELIBS=" -lpthread" ;;
	armv8-apple-*) MMELIBS=" -lpthread" ;;
	i386-apple-*) MMELIBS=" -lpthread" ;;
	x86_64-apple-*) MMELIBS=" -lpthread" ;;
	*-*-solaris*) MMELIBS=" " ;;
esac
AC_SUBST(MMELIBS)dnl

dnl	powerpc-apple-*) LIBS=" -lpthread -L../../../../shared/src/3rdParty/portaudio/lib -lportaudio -framework CoreAudio -framework AudioToolbox" ;;
dnl	i386-apple-*) LIBS=" -lpthread -L../../../../shared/src/3rdParty/portaudio/lib -lportaudio -framework CoreAudio -framework AudioToolbox" ;;
dnl	x86_64-apple-*) LIBS=" -lpthread -L../../../../shared/src/3rdParty/portaudio/lib -lportaudio -framework CoreAudio -framework AudioToolbox" ;;

LIBS=" -llmf -lpthreads -lmach -lexc -lc -lrt -lots"
case "$target" in 
	arm-ipaq-linux-*) LIBS=" -lpthread -L/skiff/local/lib/gcc-lib/arm-linux/2.95.2/ -lgcc" ;;
