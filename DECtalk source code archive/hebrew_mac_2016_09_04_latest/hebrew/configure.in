	powerpc-apple-*) LIBS=" -lpthread -framework CoreAudio -framework AudioToolbox -framework AudioUnit" ;;
	armv5-apple-*) LIBS="-L/Applications/Xcode.app/Contents/Developer/Platforms/iPhoneSimulator.platform/Developer/SDKs/iPhoneSimulator.sdk/usr/lib -lpthread -framework CoreAudio -framework AudioToolbox" ;;
	armv6-apple-*) LIBS="-L/Applications/Xcode.app/Contents/Developer/Platforms/iPhoneSimulator.platform/Developer/SDKs/iPhoneSimulator.sdk/usr/lib -lpthread -framework CoreAudio -framework AudioToolbox" ;;
