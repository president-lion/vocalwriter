SAMPLE_LINKFLAGS=" -G3"
case "$target" in
	arm-ipaq-linux-*) SAMPLE_LINKFLAGS=" -ldl -lm" ;;
	arm-*-linux-*) SAMPLE_LINKFLAGS=" -ldl" ;;
	powerpc-*-linux-*) SAMPLE_LINKFLAGS=" -ldl -lm" ;;
	*-*-solaris*) SAMPLE_LINKFLAGS=" -lm " ;;
	*-*-linux-*) SAMPLE_LINKFLAGS=" -ldl " ;;
	*-*-nto-*) SAMPLE_LINKFLAGS=" " ;;
	powerpc-apple-*) SAMPLE_LINKFLAGS=" -ldl -arch ppc" ;;
	armv5-apple-*) SAMPLE_LINKFLAGS="-isysroot /Applications/Xcode.app/Contents/Developer/Platforms/iPhoneSimulator.platform/Developer/SDKs/iPhoneSimulator.sdk -ldl -arch i386" ;;
	armv6-apple-*) SAMPLE_LINKFLAGS="-isysroot /Applications/Xcode.app/Contents/Developer/Platforms/iPhoneSimulator.platform/Developer/SDKs/iPhoneSimulator.sdk -ldl -arch x86_64" ;;
	armv7-apple-*) SAMPLE_LINKFLAGS="-isysroot /Applications/Xcode.app/Contents/Developer/Platforms/iPhoneOS.platform/Developer/SDKs/iPhoneOS.sdk -ldl -arch armv7" ;;
	armv8-apple-*) SAMPLE_LINKFLAGS="-isysroot /Applications/Xcode.app/Contents/Developer/Platforms/iPhoneOS.platform/Developer/SDKs/iPhoneOS8.3.sdk -ldl -arch arm64" ;;
	i386-apple-*) SAMPLE_LINKFLAGS=" -ldl -arch i386" ;;
	x86_64-apple-*) SAMPLE_LINKFLAGS=" -ldl -arch x86_64" ;;
esac
AC_SUBST(SAMPLE_LINKFLAGS)dnl

